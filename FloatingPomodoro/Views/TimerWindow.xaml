<Window x:Class="FloatingPomodoro.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Pomodoro"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        Topmost="{Binding AlwaysOnTop}" Opacity="{Binding Opacity}"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" KeyDown="Window_KeyDown" Closing="Window_Closing">

    <Window.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding StartPauseText}" Click="StartPause_Click" InputGestureText="Space"/>
            <MenuItem Header="Reset" Click="Reset_Click" InputGestureText="R"/>
            <MenuItem Header="Skip" Click="Skip_Click" InputGestureText="S"/>
            <Separator/>
            <MenuItem Header="Pomodoro" Click="ModeFocus_Click"/>
            <MenuItem Header="Short Break" Click="ModeShort_Click"/>
            <MenuItem Header="Long Break" Click="ModeLong_Click"/>
            <Separator/>
            <MenuItem Header="Always On Top" IsCheckable="True" IsChecked="{Binding AlwaysOnTop}"/>
            <MenuItem Header="Mini Mode" IsCheckable="True" IsChecked="{Binding MiniMode}" InputGestureText="Double-click"/>
            <MenuItem Header="Tasks..." Click="Tasks_Click"/>
            <MenuItem Header="Statistics..." Click="Stats_Click"/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
            <Separator/>
            <MenuItem Header="Hide" Click="Hide_Click" InputGestureText="Esc"/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <!-- Timer text that pulses gently while Finished is true -->
        <Style x:Key="TimerText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Finished}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Flash">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Flash"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Normal floating mode (~280 x 180) -->
        <Border Width="280" CornerRadius="18" Background="{DynamicResource BgBrush}" Padding="18,12,18,14"
                Visibility="{Binding MiniMode, Converter={StaticResource VisInv}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⋮" FontSize="15" Padding="6,0" Click="Menu_Click" ToolTip="Menu (right-click anywhere)"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{Binding TimerText}" Style="{StaticResource TimerText}" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,2"/>

                <ProgressBar Style="{StaticResource ThinBar}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="8,0"
                             Visibility="{Binding ShowProgressBar, Converter={StaticResource Vis}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,6">
                    <Button Style="{StaticResource IconButton}" Content="↻" Click="Reset_Click" ToolTip="Reset (R)"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PlayGlyph}" Click="StartPause_Click" Margin="16,0" ToolTip="Start / Pause (Space)"/>
                    <Button Style="{StaticResource IconButton}" Content="⏭" Click="Skip_Click" ToolTip="Skip (S)"/>
                </StackPanel>

                <Button Style="{StaticResource IconButton}" Click="Tasks_Click" FontFamily="Segoe UI" FontSize="13" Padding="6,2"
                        HorizontalAlignment="Center" Foreground="{DynamicResource Fg2Brush}" MaxWidth="240" ToolTip="Tasks"
                        Visibility="{Binding ShowTaskName, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding CurrentTaskTitle}" TextTrimming="CharacterEllipsis"/>
                </Button>

                <DockPanel Margin="2,4,2,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TodayText}" Foreground="{DynamicResource Fg2Brush}" FontSize="11" ToolTip="Pomodoros completed today"/>
                    <TextBlock Text="{Binding CycleDots}" Foreground="{DynamicResource AccentBrush}" FontSize="11" ToolTip="Position in the long-break cycle"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Mini mode (~220 x 52) -->
        <Border CornerRadius="14" Background="{DynamicResource BgBrush}" Padding="14,6,8,6"
                Visibility="{Binding MiniMode, Converter={StaticResource Vis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimerText}" Style="{StaticResource TimerText}" FontSize="22" Margin="10,0,8,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButton}" Content="{Binding PlayGlyph}" FontSize="15" Padding="6,2" Click="StartPause_Click"/>
                <Button Style="{StaticResource IconButton}" Content="⋮" FontSize="15" Padding="6,2" Click="Menu_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
