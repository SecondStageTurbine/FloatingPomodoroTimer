<Window x:Class="FloatingPomodoro.Views.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource Dialog}" WindowStartupLocation="CenterScreen"
        Title="Tasks" Width="360" Height="440" Activated="Window_Activated">
    <DockPanel Margin="16,12,16,14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Text="TODAY" Margin="0"/>
        <TextBlock DockPanel.Dock="Top" x:Name="Estimate" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,8"/>

        <!-- Add task row -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTitle" Padding="4" VerticalContentAlignment="Center" KeyDown="NewTitle_KeyDown" ToolTip="What are you working on?"/>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="−" FontSize="14" Padding="6,0" Click="EstMinus_Click" ToolTip="Estimated pomodoros"/>
            <TextBlock Grid.Column="2" x:Name="EstText" Text="1" VerticalAlignment="Center" MinWidth="16" TextAlignment="Center"/>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="+" FontSize="14" Padding="6,0" Click="EstPlus_Click" ToolTip="Estimated pomodoros"/>
            <Button Grid.Column="4" Content="Add" Padding="12,4" Margin="6,0,0,0" Click="Add_Click"/>
        </Grid>

        <ListBox x:Name="List" ItemsSource="{Binding Tasks}" SelectedItem="{Binding CurrentTask}"
                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="ToolTip" Value="Click to make this the current task"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" Click="Done_Click" ToolTip="Complete"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" FontSize="11" Padding="6,2"
                                Foreground="{DynamicResource Fg2Brush}" Click="Delete_Click" ToolTip="Delete"/>
                        <TextBlock DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Fg2Brush}">
                            <Run Text="{Binding Completed, Mode=OneWay}"/>/<Run Text="{Binding Estimated, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
