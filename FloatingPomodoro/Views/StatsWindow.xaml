<Window x:Class="FloatingPomodoro.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource Dialog}" WindowStartupLocation="CenterScreen"
        Title="Statistics" Width="380" SizeToContent="Height" Activated="Window_Activated">
    <Window.Resources>
        <DataTemplate x:Key="BarRow">
            <DockPanel Margin="0,2">
                <TextBlock Text="{Binding Label}" Width="36" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="44"/>
                <Border Background="{DynamicResource AccentBrush}" Height="10" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding Width}" Opacity="{Binding Opacity}"/>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl MinHeight="260">
        <TabItem Header="Today">
            <StackPanel Style="{StaticResource Pane}" Margin="16,12">
                <TextBlock x:Name="TodayTime" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock Text="focused" Style="{StaticResource Muted}" Margin="0,-4,0,14"/>
                <TextBlock x:Name="TodayPomodoros" FontSize="14"/>
                <TextBlock x:Name="TodayTasks" FontSize="14" Margin="0,4,0,0"/>
                <TextBlock x:Name="TotalLine" Style="{StaticResource Muted}" FontSize="12" Margin="0,22,0,0"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Week">
            <StackPanel Style="{StaticResource Pane}" Margin="16,12">
                <TextBlock x:Name="WeekSummary" FontSize="14" Margin="0,0,0,10"/>
                <ItemsControl x:Name="WeekBars" ItemTemplate="{StaticResource BarRow}"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Month">
            <StackPanel Style="{StaticResource Pane}" Margin="16,12">
                <TextBlock x:Name="MonthSummary" FontSize="14" Margin="0,0,0,10"/>
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MonthBars" ItemTemplate="{StaticResource BarRow}"/>
                </ScrollViewer>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
